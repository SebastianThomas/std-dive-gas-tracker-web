# Local development defaults (committed). Override per machine in .env.development.local.
# Gas-tracker backend: `mvn spring-boot:run` in std-dive-gas-tracker (port 8090).
VITE_BACKEND_URL=http://localhost:8090
# Dive-logger ws (token issuer). Only needed for the real login; see AGENTS.md.
VITE_AUTH_URL=http://localhost:8080
# Dev login against the gas backend's `dev-login` profile - never set in staging/production.
VITE_DEV_LOGIN=true
